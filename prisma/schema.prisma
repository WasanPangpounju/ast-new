generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

// ─── MASTER DATA ─────────────────────────────────────

model Employee {
  id         Int      @id @default(autoincrement())
  empID      String   @unique
  name       String
  ssn        String?
  tel        String?
  gender     String?
  birthdate  String?
  department String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  tax       String?
  address   String?
  tel       String?
  email     String?
  type      String?
  coor      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customers")
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  tax       String?
  address   String?
  tel       String?
  email     String?
  type      String?
  coor      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  packages  Package[]

  @@map("suppliers")
}

model Stuff {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stuffs")
}

model Coordinator {
  id       Int     @id @default(autoincrement())
  tax      String
  name     String
  jobTitle String? @map("job_title")
  tel      String?

  @@index([tax])
  @@map("coordinators")
}

// ─── PURCHASE ORDERS ─────────────────────────────────

model AstPurchaseOrder {
  id              Int       @id @default(autoincrement())
  /// SO series type: 'SO' | 'SOX' | 'SOB'
  vat             String
  /// Formatted SO number e.g. "SO6804/12" — used as logical FK across tables
  purchaseOrder   String    @unique
  po              String?
  emp             String?
  customerName    String?
  fabricId        String?
  fabricPattern   String?
  fabricStructure String?
  orderSumYard    Float?
  orderSumM       Float?    @map("order_sum_m")
  fabricSPY       Float?    @map("fabric_spy")
  fabricSpP       Float?    @map("fabric_sp_p")
  priceYard       Float?    @map("price_yard")
  priceM          Float?    @map("price_m")
  discountP       Float?    @map("discount_p")
  discountYard    Float?    @map("discount_yard")
  commission      Float?
  billNo          Int?      @map("bill_no")
  machineNumber   String?   @map("machine_number")
  surcharge       String?
  note            String?
  productionNote  String?   @map("production_note")
  createDate      DateTime  @default(now()) @map("create_date")
  /// Denormalized copy of status — kept in sync with fabricAstStructure.yarnWRatio2
  status          String?
  deadline        String?
  payment         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  fabricAst          FabricAst?
  fabricAstStructure FabricAstStructure?
  orderDeadlines     OrderDeadline[]
  production         Production?
  fabricOuts         FabricOut[]
  inventories        Inventory[]
  orderShipped       OrderShipped?
  billOfStructure    AstBillOfStructure?

  @@index([vat])
  @@index([customerName])
  @@index([fabricPattern])
  @@map("ast_purchaseorders")
}

model OrderDeadline {
  id            Int       @id @default(autoincrement())
  /// References ast_purchaseorders.purchaseOrder string
  purchaseOrder String
  dt            DateTime?
  label         String?
  qty           Float?
  unit          String?
  pct           Float?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order AstPurchaseOrder @relation(fields: [purchaseOrder], references: [purchaseOrder])

  @@index([purchaseOrder])
  @@map("orderdeadlines")
}

model OrderShipped {
  id            Int       @id @default(autoincrement())
  purchaseOrder String    @unique
  emp           String?
  shippedDate   DateTime?
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order AstPurchaseOrder @relation(fields: [purchaseOrder], references: [purchaseOrder])

  @@map("ordershippeds")
}

// ─── FABRIC SPECS ─────────────────────────────────────

model FabricAst {
  id            Int      @id @default(autoincrement())
  purchaseOrder String   @unique
  vat           String?
  yarnHCount    String?  @map("yarn_h_count")
  fabricW       String?  @map("fabric_w")
  phewNumber    String?
  phewW         String?
  stackType     String?  @map("stack_type")
  payment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order AstPurchaseOrder @relation(fields: [purchaseOrder], references: [purchaseOrder])

  @@index([purchaseOrder])
  @@map("fabric_asts")
}

model FabricAstStructure {
  id            Int      @id @default(autoincrement())
  purchaseOrder String   @unique
  yarnHType     String?
  yarnHType2    String?  @map("yarn_h_type2")
  subNameH1     String?  @map("sub_name_h1")
  subNameH2     String?  @map("sub_name_h2")
  yarnWType     String?
  yarnWType2    String?  @map("yarn_w_type2")
  yarnWType3    String?  @map("yarn_w_type3")
  yarnWType4    String?  @map("yarn_w_type4")
  subNameW1     String?  @map("sub_name_w1")
  subNameW2     String?  @map("sub_name_w2")
  subNameW3     String?  @map("sub_name_w3")
  subNameW4     String?  @map("sub_name_w4")
  /// ⚠ REPURPOSED AS ORDER STATUS FIELD
  /// Values: 'no data' | 'อนุมัติให้ผลิต' |
  yarnWRatio2   String?
  yarnHRatio1   String?
  yarnHRatio2   String?
  yarnWRatio1   String?
  weftRatio2    String?  @map("weft_ratio2")
  yarnWRatio3   String?  @map("yarn_w_ratio3")
  yarnWRatio4   String?  @map("yarn_w_ratio4")
  yarnHCount1   String?
  yarnHCount2   String?
  yarnWCount1   String?
  yarnWCount2   String?
  yarnWCount3   String?  @map("yarn_w_count3")
  yarnWCount4   String?  @map("yarn_w_count4")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order AstPurchaseOrder @relation(fields: [purchaseOrder], references: [purchaseOrder])

  @@index([purchaseOrder])
  @@index([yarnWRatio2])
  @@map("fabric_aststructures")
}

// ─── FABRIC OPERATIONS ───────────────────────────────

model FabricOut {
  id            Int       @id @default(autoincrement())
  /// Random base64 session token — groups all rolls in one delivery
  refId         String
  /// SO number string e.g. "SO5807/28" — direct match to ast_purchaseorders.purchaseOrder
  purchaseOrder String?
  /// Global serial number across all fabricout records
  no            String?
  /// Invoice series: 'A' | 'B' | 'C'
  vatType       String
  /// Running invoice number per series, starting at 1001
  vatNo         Int
  /// Sequential roll number within this delivery (1, 2, 3…)
  fold          Int
  /// Yards in this specific roll
  sumYard       Float
  fabricStruct  String?
  fabricPattern String?
  fabricW       String?
  customerName  String?
  receiveName   String?
  orderId       Int?
  createDate    DateTime  @default(now())
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  isDeposit        Boolean   @default(false)
  altFabricStruct  String?
  altPurchaseOrder String?

  order AstPurchaseOrder? @relation(fields: [orderId], references: [id])

  @@index([refId])
  @@index([vatType, vatNo])
  @@index([orderId])
  @@index([customerName])
  @@map("fabricouts")
}

model StockFabric {
  id            Int       @id @default(autoincrement())
  refId         String
  emp           String?
  fabricStruct  String?
  fabricPattern String?
  fabricW       String?
  fabricCode    String?
  fold          Int?
  sumYard       Float?
  customer      String?
  createDate    DateTime  @default(now())
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  isPurchased   Boolean   @default(false) @map("is_purchased")
  supplier      String?
  billRef       String?   @map("bill_ref")
  pricePerYard  Float?    @map("price_per_yard")
  dyeLot        String?   @map("dye_lot")

  @@index([refId])
  @@index([fabricPattern])
  @@index([isPurchased])
  @@map("stockfabrics")
}

model FabricImport {
  id        Int      @id @default(autoincrement())
  refId     String
  emp       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([refId])
  @@map("fabricimports")
}

model FabricDeposit {
  id        Int      @id @default(autoincrement())
  refId     String
  emp       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([refId])
  @@map("fabricdeposits")
}

model FabricOutDeposit {
  id           Int      @id @default(autoincrement())
  refId        String
  emp          String?
  customerName String?
  fabricStruct String?
  fabricW      String?
  fold         Int?
  sumYard      Float?
  /// 'normal' | 'replacement'
  receiveType  String?
  vatType      String?
  createDate   DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([refId])
  @@map("fabricoutdeposits")
}

// ─── INVENTORY ───────────────────────────────────────

model Inventory {
  id            Int      @id @default(autoincrement())
  refId         String
  emp           String?
  inventoryName String?
  orderId       Int?
  fabricStruct  String?
  fold          Int?
  sumYard       Float?
  sumM          Float?
  fabricW       String?
  createDate    DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order AstPurchaseOrder? @relation(fields: [orderId], references: [id])

  @@index([refId])
  @@index([orderId])
  @@map("inventories")
}

model Production {
  id            Int      @id @default(autoincrement())
  purchaseOrder String   @unique
  machineNumber String?
  no            String?
  fabricStruct  String?
  fabricPattern String?
  fabricW       String?
  yarnHType     String?
  yarnWType     String?
  pricing       Float?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order AstPurchaseOrder @relation(fields: [purchaseOrder], references: [purchaseOrder])

  @@index([purchaseOrder])
  @@map("productions")
}

// ─── MATERIALS ───────────────────────────────────────

model Material {
  // รับเส้นด้ายเข้าคลัง (แทน table `materials` ใน MySQL เดิม)
  id              Int       @id @default(autoincrement())
  lot             String
  spool           Int
  yarnType        String
  supplierName    String
  weightKgNet     Float
  weightKgSum     Float
  weightKgPackage Float

  // บรรจุภัณฑ์
  pallet          Int?      // จำนวน pallet
  box             Int?      // จำนวน box
  sack            Int?      // จำนวน sack

  // น้ำหนัก pounds (เก็บไว้เพื่อ traceability จากระบบเดิม)
  weightPNet      Float?    // น้ำหนัก pounds ต่อ spool
  weightPSum      Float?    // น้ำหนัก pounds รวม
  weightPPackage  Float?    // น้ำหนัก pounds รวมทั้งหีบห่อ
  averageKg       Float?    // เฉลี่ย kg ต่อ spool
  averageP        Float?    // เฉลี่ย pounds ต่อ spool

  // พนักงานรับผิดชอบ
  emp             String?   // ชื่อพนักงานที่รับเข้า (จาก MySQL column `emp`)

  importStatus    String    @default("pending")
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  requisitions    MaterialRequisition[]
  outsides        MaterialOutside[]
  returns         MaterialReturn[]

  @@map("materials")
}

model MaterialStock {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("materialstocks")
}

model MaterialStore {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("materialstores")
}

model MaterialOutside {
  id              Int       @id @default(autoincrement())
  withdrawId      String
  lot             String?
  yarnType        String
  supplierName    String?
  spool           Int
  weightWithdrawn Float
  weightPSum      Float?
  weightKgSum     Float?
  weightPPackage  Float?
  weightKgPackage Float?
  averageP        Float?
  averageKg       Float?
  materialId      Int?
  material        Material? @relation(fields: [materialId], references: [id])
  note            String?
  returnPallet    Boolean   @default(false)
  returnBox       Boolean   @default(false)
  returnSack      Boolean   @default(false)
  returnSpool     Boolean   @default(false)
  returnPaperBar  Boolean   @default(false)
  recipient       String?
  usageNote       String?
  paymentComment  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("material_outsides")
}

model MaterialReturn {
  id           Int       @id @default(autoincrement())
  returnId     String
  lot          String?
  yarnType     String
  supplierName String?
  spool        Int
  weightReturn Float
  materialId   Int?
  material     Material? @relation(fields: [materialId], references: [id])
  note         String?
  returnDate   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("material_returns")
}

model MaterialRequisition {
  // เบิกเส้นด้ายออกใช้งาน (แทน table `materialstores` ใน MySQL เดิม)
  id              Int       @id @default(autoincrement())
  withdrawId      String
  // nullable: legacy rows จาก MySQL ไม่มี FK กลับ materials
  materialId      Int?
  material        Material? @relation(fields: [materialId], references: [id])
  department      String
  emp             String?
  spool           Int
  weightWithdrawn Float
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("materialrequisitions")
}

model MaterialCoordinator {
  // พนักงานที่รับผิดชอบวัตถุดิบ (แทน table `empmaterials` ใน MySQL เดิม)
  id         Int       @id @default(autoincrement())
  name       String
  tel        String?
  department String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@map("materialcoordinators")
}

// ─── PACKAGES ────────────────────────────────────────

model Package {
  id            Int      @id @default(autoincrement())
  supplierId    Int?
  supplierName  String?
  emp           String?
  spool         Int?
  sack          Int?
  box           Int?
  pallet        Int?
  packageStatus String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("packages")
}

/// Historical package records before the Package system was introduced
model HtrPackage {
  id           Int      @id @default(autoincrement())
  supplierName String?
  emp          String?
  spool        Int?
  sack         Int?
  box          Int?
  pallet       Int?
  createDate   DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("htrpackages")
}

model PackageAst {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("packageasts")
}

// ─── BILL OF STRUCTURE ───────────────────────────────

model AstBillOfStructure {
  id              Int       @id @default(autoincrement())
  /// References AstPurchaseOrder.purchaseOrder
  purchaseOrder   String    @unique
  sourceOrderId   Int       @unique
  vat             String?
  customerName    String?
  emp             String?
  fabricId        String?
  fabricPattern   String?
  fabricStructure String?
  // Fabric specs (from FabricAst)
  yarnHCount      String?
  fabricW         String?
  phewNumber      String?
  phewW           String?
  stackType       String?
  // Warp yarns
  warpYarn1       String?
  warpComp1       String?
  warpCount1      String?
  warpRatio1      String?
  warpYarn2       String?
  warpComp2       String?
  warpCount2      String?
  warpRatio2      String?
  // Weft yarns
  weftYarn1       String?
  weftComp1       String?
  weftCount1      String?
  weftRatio1      String?
  weftYarn2       String?
  weftComp2       String?
  weftCount2      String?
  weftRatio2      String?
  weftYarn3       String?
  weftComp3       String?
  weftCount3      String?
  weftRatio3      String?
  weftYarn4       String?
  weftComp4       String?
  weftCount4      String?
  weftRatio4      String?
  // Order quantities
  orderSumYard    Float?
  fabricSPY       Float?
  // Pricing
  priceYard       Float?    @map("price_yard")
  priceM          Float?    @map("price_m")
  discountP       Float?    @map("discount_p")
  // Other
  machineNumber   String?   @map("machine_number")
  surcharge       String?
  commission      Float?
  po              String?
  note            String?
  productionNote  String?   @map("production_note")
  payment         String?
  createDate      DateTime  @default(now()) @map("create_date")
  status          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sourceOrder AstPurchaseOrder @relation(fields: [sourceOrderId], references: [id])
  deadlines   BosDeadline[]

  @@index([purchaseOrder])
  @@index([sourceOrderId])
  @@map("ast_bill_of_structures")
}

model BosDeadline {
  id        Int                @id @default(autoincrement())
  bosId     Int
  dt        DateTime?
  label     String?
  qty       Float?
  unit      String?
  pct       Float?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  bos AstBillOfStructure @relation(fields: [bosId], references: [id])

  @@index([bosId])
  @@map("bos_deadlines")
}

// ─── LEGACY (DO NOT USE FOR NEW FEATURES) ────────────

/// @deprecated — superseded by AstPurchaseOrder (ast_purchaseorders)
model LegacyPurchaseOrder {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("purchaseorders")
}
